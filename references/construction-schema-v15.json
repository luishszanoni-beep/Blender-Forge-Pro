{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-forge-pro.local/gcb/v1.0",
  "title": "Geometric Construction Blueprint v1.0",
  "description": "Typed geometry contract for G1.5; deeper cross-reference and anchor checks are performed by scripts/gcb.py",
  "type": "object",
  "required": ["gcb_version", "project_id", "target", "units", "source_references", "parts", "attachments", "steps"],
  "properties": {
    "gcb_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$"},
    "target": {"enum": ["roblox", "web_glb", "render", "general"]},
    "visual_style": {"type": "string"},
    "units": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["relative", "mm"]}}},
    "physical_dimensions_declared": {"type": "boolean"},
    "source_references": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "vec3": {"type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "items":false, "minItems":3},
    "source": {"type":"object", "required":["id","projection","calibrated"], "properties":{"id":{"type":"string"},"path":{"type":"string"},"projection":{"enum":["orthographic","perspective","unknown"]},"calibrated":{"type":"boolean"}}},
    "part": {"type":"object", "required":["id","label","primitive","dimensions","position","rotation_deg","stage","confidence","source_ids","separate_mesh"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"primitive":{"enum":["box","cylinder","sphere","cone","wedge","custom_mesh"]},"dimensions":{"$ref":"#/$defs/vec3"},"position":{"$ref":"#/$defs/vec3"},"rotation_deg":{"$ref":"#/$defs/vec3"},"parent":{"type":["string","null"]},"pivot":{"$ref":"#/$defs/vec3"},"stage":{"type":"integer","minimum":1},"confidence":{"enum":["observed","inferred","unknown"]},"source_ids":{"type":"array","items":{"type":"string"}},"separate_mesh":{"const":true},"geometry_recipe":{"type":"object", "properties":{"vertices":{"type":"array","items":{"$ref":"#/$defs/vec3"}},"faces":{"type":"array","items":{"type":"array","minItems":3,"items":{"type":"integer","minimum":0}}}}}}},
    "attachment":{"type":"object","required":["child","parent","anchor_child","anchor_parent","tolerance"],"properties":{"child":{"type":"string"},"parent":{"type":"string"},"anchor_child":{"$ref":"#/$defs/vec3"},"anchor_parent":{"$ref":"#/$defs/vec3"},"tolerance":{"type":"number","minimum":0}}},
    "step":{"type":"object","required":["id","title","parts"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"parts":{"type":"array","minItems":1,"items":{"type":"string"}},"notes":{"type":"string"}}}
  }
}
